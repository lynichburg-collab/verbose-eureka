#!/core/cmd/sh
# startup — run once by keeper (process 1), after the kernel filesystems are
# mounted and before any terminal starts. Boot policy lives here so it can
# change without recompiling keeper.
export PATH=/core/cmd

. /settings/about
echo "Starting $PRETTY_NAME"

hostname -F /settings/hostname

# --- Hardware --------------------------------------------------------------
# Firmware for Wi-Fi cards and GPUs lives in /core/firmware.
if [ -w /sys/module/firmware_class/parameters/path ]; then
    echo /core/firmware > /sys/module/firmware_class/parameters/path
fi

# Hotplug: devices that appear later (USB sticks...) get their driver too.
# The kernel is built with this already; set it again in case of a custom kernel.
[ -w /proc/sys/kernel/hotplug ] && echo /core/cmd/mdev > /proc/sys/kernel/hotplug

# Coldplug: load drivers for every device already present.
kver="$(uname -r)"
if [ -f "/core/drivers/$kver/modules.dep" ]; then
    find /sys/devices -name modalias -type f -exec cat {} + 2>/dev/null \
        | sort -u | xargs -r modprobe -qa 2>/dev/null
fi
mdev -s

# --- Network ---------------------------------------------------------------
ip link set lo up
: > /run/resolv.conf
for dev in /sys/class/net/*; do
    name="${dev##*/}"
    case "$name" in lo) continue ;; esac
    [ -d "$dev/wireless" ] && continue          # Wi-Fi needs credentials first
    ip link set "$name" up
    udhcpc -b -q -i "$name" >/dev/null 2>&1 &
done

# --- Self-test (kernel command line: mtp.test=1) ----------------------------
case " $(cat /proc/cmdline) " in
    *" mtp.test=1 "*)
        /core/boot/checkup
        poweroff
        ;;
esac
