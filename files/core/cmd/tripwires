#!/core/cmd/sh
# tripwires — show what has touched the decoys since boot.
#   tripwires          show the log
#   tripwires --clear  empty it
log=/var/log/tripwire
case "$1" in
    --clear) : > "$log"; echo "Tripwire log cleared."; exit 0 ;;
    -h|--help) sed -n '2,4s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac
if [ -s "$log" ]; then
    echo "Decoys touched since boot ($(wc -l < "$log")):"
    echo
    cat "$log"
else
    echo "No tripwires touched since boot."
fi
