# Read by every login shell.
# /bin and /usr/bin hold only decoys (tripwires). Real commands come first.
export PATH=/core/cmd:/bin:/usr/bin
export HOME="${HOME:-/users/root}"
export EDITOR=vi
export PAGER=less
umask 022

. /settings/about
if [ "$(id -u)" = 0 ]; then
    PS1='\[\e[1;31m\]\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]# '
else
    PS1='\[\e[0;33m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]$ '
fi
cd "$HOME" 2>/dev/null
# Welcome screen with Emti: themed colors on the machine's own screens,
# 24-bit color elsewhere, plain text as a fallback.
case "$(tty)" in
    /dev/tty[0-9]*)        welcome=/core/share/welcome.vt ;;
    /dev/ttyS*|/dev/pts/*) welcome=/core/share/welcome.ansi ;;
    *)                     welcome=/core/share/welcome ;;
esac
[ -f "$welcome" ] && cat "$welcome"
if [ -s /var/log/tripwire ]; then
    printf '\033[1;33m  Warning: decoys were touched %s time(s) since boot. Run: tripwires\033[0m\n\n' \
        "$(wc -l < /var/log/tripwire)"
fi
