# Read by every login shell.
# /bin and /usr/bin hold only decoys (tripwires). Real commands come first.
export PATH=/core/cmd:/bin:/usr/bin
export HOME="${HOME:-/users/root}"
export EDITOR=vi
export PAGER=less
umask 022

. /settings/about
if [ "$(id -u)" = 0 ]; then
    PS1='\[\e[1;31m\]\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]# '
else
    PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]$ '
fi
cd "$HOME" 2>/dev/null
[ -f /core/share/welcome ] && cat /core/share/welcome
if [ -s /var/log/tripwire ]; then
    printf '\033[1;33m  Warning: decoys were touched %s time(s) since boot. Run: tripwires\033[0m\n\n' \
        "$(wc -l < /var/log/tripwire)"
fi
