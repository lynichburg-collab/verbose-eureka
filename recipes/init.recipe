# Our own init (process 1). Source lives in this repo: src/init/.
NAME=init
VERSION="$OS_VERSION"
SOURCE_LOCAL=src/init
INPUTS="src/init"

build() {
    # shellcheck disable=SC2086
    $TARGET_CC $TARGET_CFLAGS -Wall -Wextra -Werror -o "$BUILD/init" "$SRC/init.c" $TARGET_LDFLAGS
    strip "$BUILD/init"
}

install() {
    # 'command' because this function is itself named install.
    command install -D -m 0755 "$BUILD/init" "$ROOTFS/system/bin/init"
}
