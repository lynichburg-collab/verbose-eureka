# Applied on top of the upstream x86_64_defconfig.
# Goal: boot on generic x86_64 hardware. Core boot path is built in; most
# hardware drivers are modules, loaded at boot only when the device exists.

# --- Identity and boot ---
CONFIG_LOCALVERSION="-mtp"
CONFIG_DEFAULT_HOSTNAME="mtplatitudes"
CONFIG_DEFAULT_INIT="/core/cmd/keeper"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FW_LOADER=y
# Hotplug: the kernel runs mdev for each device event (driver autoload).
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH="/core/cmd/mdev"

# --- Hardening (beyond defconfig) ---
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_LEGACY_TIOCSTI=n

# --- Storage and filesystems ---
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=m
CONFIG_BTRFS_FS=m
CONFIG_SQUASHFS=m
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m

# --- USB ---
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m

# --- Input (laptop keyboards, i2c touchpads) ---
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_EVDEV=y

# --- Display: generic EFI framebuffer now, Intel GPU driver as a module ---
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_I915=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Networking ---
CONFIG_PACKET=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8152=m

# --- Sound ---
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m

# --- Virtual machines (QEMU testing) ---
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
