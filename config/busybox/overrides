# Changes applied on top of BusyBox's defconfig. One setting per line, in
# .config syntax. The part applies them and runs oldconfig.

# Single static binary, no shared libraries needed at runtime.
CONFIG_STATIC=y

# We have our own init (src/init). halt/poweroff/reboot signal PID 1.
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set
# CONFIG_FEATURE_CALL_TELINIT is not set

# Our filesystem layout.
CONFIG_DEFAULT_MODULES_DIR="/core/drivers"
CONFIG_UDHCPC_DEFAULT_SCRIPT="/core/net/dhcp-lease"

# Does not build against current kernel headers (uses removed CBQ API).
# CONFIG_TC is not set
# CONFIG_FEATURE_TC_INGRESS is not set
