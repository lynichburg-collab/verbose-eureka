#!/usr/bin/env bash
# forge — builds the whole OS from source.
#
#   ./forge            build everything and produce out/kernel + out/rootfs.cpio.gz
#   ./forge <part>     (re)build one part, e.g. ./forge busybox
#   ./forge image      reassemble the root filesystem and initramfs only
#   ./forge test       boot the result in QEMU and run the checkup
#   ./forge run        boot the result in QEMU interactively (Ctrl-A X quits)
#   ./forge try        download the latest build that passed on GitHub and run it
#   ./forge clean      delete build output, keep downloaded sources
#   ./forge distclean  delete everything, including downloaded sources
#
# Each part of the OS is described by parts/<name>.part (see parts/README.md).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=about.conf
. "$ROOT/about.conf"

WORK="${WORK:-$ROOT/work}"
SOURCES="$WORK/sources"
BUILDS="$WORK/build"
ROOTFS="$WORK/rootfs"
SYSROOT="$WORK/sysroot"          # kernel headers for userland builds
OUT="${OUT:-$ROOT/out}"
JOBS="${JOBS:-$(nproc)}"
export ROOT WORK SOURCES BUILDS ROOTFS SYSROOT OUT JOBS ARCH OS_ID OS_NAME OS_VERSION

# Userland is linked statically against musl. Kernel headers come from our own
# kernel source (installed into $SYSROOT by the linux part), not the host.
export TARGET_CC="musl-gcc"
export TARGET_CFLAGS="-Os -pipe -static -isystem $SYSROOT/include"
export TARGET_LDFLAGS="-static"

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

need_tools() {
    local missing=()
    for t in git make gcc musl-gcc flex bison bc cpio gzip rsync depmod sha256sum; do
        command -v "$t" >/dev/null 2>&1 || missing+=("$t")
    done
    [ ${#missing[@]} -eq 0 ] || die "missing host tools: ${missing[*]} (see README: Building)"
}

# --- parts ------------------------------------------------------------------

part_file() { echo "$ROOT/parts/$1.part"; }

# Load a part into a clean set of variables. Call inside a subshell.
load_part() {
    local name="$1" file
    file="$(part_file "$name")"
    [ -f "$file" ] || die "no part named '$name' ($file)"
    NAME="" VERSION="" SOURCE_GIT="" SOURCE_REF="" SOURCE_LOCAL="" INPUTS=""
    unset -f build install 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$file"
    [ "$NAME" = "$name" ] || die "$file: NAME must be '$name'"
    if [ -n "$SOURCE_LOCAL" ]; then
        SRC="$ROOT/$SOURCE_LOCAL"
    else
        SRC="$SOURCES/$NAME-$VERSION"
    fi
    BUILD="$BUILDS/$NAME"
    export NAME VERSION SRC BUILD
}

fetch() {
    [ -n "$SOURCE_LOCAL" ] && return 0
    if [ -d "$SRC/.git" ] || [ -f "$SRC/.fetched" ]; then return 0; fi
    log "fetch $NAME $VERSION ($SOURCE_GIT @ $SOURCE_REF)"
    rm -rf "$SRC.tmp"
    git clone --quiet --depth 1 --branch "$SOURCE_REF" "$SOURCE_GIT" "$SRC.tmp"
    mv "$SRC.tmp" "$SRC"
}

# Apply patches/<part>/*.patch to a fetched source tree. The tree is reset
# first, so changing or removing a patch always takes effect.
apply_patches() {
    [ -n "$SOURCE_LOCAL" ] && return 0
    local dir="$ROOT/patches/$NAME" want have p
    want="$( { cat "$dir"/*.patch 2>/dev/null || true; } | sha256sum | cut -d' ' -f1)"
    have="$(cat "$SRC/.mtp-patches" 2>/dev/null || true)"
    [ "$want" = "$have" ] && return 0
    git -C "$SRC" checkout -q -- .
    git -C "$SRC" clean -fdq
    for p in "$dir"/*.patch; do
        [ -e "$p" ] || continue
        log "patch $NAME: ${p##*/}"
        git -C "$SRC" apply "$p" || die "patch ${p##*/} does not apply to $NAME $VERSION"
    done
    echo "$want" > "$SRC/.mtp-patches"
}

# A part is rebuilt when its .part file, its patches or any of its INPUTS change.
fingerprint() {
    {
        cat "$(part_file "$NAME")"
        cat "$ROOT/patches/$NAME"/*.patch 2>/dev/null || true
        for f in $INPUTS; do
            if [ -d "$ROOT/$f" ]; then
                find "$ROOT/$f" -type f -print0 | sort -z | xargs -0 cat
            else
                cat "$ROOT/$f"
            fi
        done
        echo "$TARGET_CC $TARGET_CFLAGS"
    } | sha256sum | cut -d' ' -f1
}

build_part() (
    load_part "$1"
    fetch
    apply_patches
    local fp stamp="$BUILD/.built"
    fp="$(fingerprint)"
    if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$fp" ] && [ "${FORCE:-0}" != 1 ]; then
        log "$NAME $VERSION is up to date"
        return 0
    fi
    log "build $NAME $VERSION"
    mkdir -p "$BUILD"
    rm -f "$stamp"
    build
    echo "$fp" > "$stamp"
)

install_part() (
    load_part "$1"
    [ -f "$BUILD/.built" ] || die "$NAME has not been built"
    install
)

# --- root filesystem and image ----------------------------------------------

assemble_rootfs() {
    log "assemble root filesystem"
    rm -rf "$ROOTFS"
    mkdir -p "$ROOTFS"
    # Files that ship with the OS as-is (settings, boot scripts, welcome...).
    cp -a "$ROOT/files/." "$ROOTFS/"
    # Our filesystem layout. See README: Filesystem layout.
    mkdir -p "$ROOTFS"/core/{cmd,boot,net,drivers,firmware,share} \
             "$ROOTFS"/{settings,users/root,var/log,dev,proc,sys,run,tmp}
    chmod 0600 "$ROOTFS/settings/shadow"
    chmod 1777 "$ROOTFS/tmp"
    chmod 0700 "$ROOTFS/users/root"
    # Compatibility link: musl and a few BusyBox commands look in /etc. This
    # goes away once we patch those paths at build time.
    ln -sfn settings "$ROOTFS/etc"
    # resolv.conf lives in /run so /settings can later be read-only.
    ln -sfn /run/resolv.conf "$ROOTFS/settings/resolv.conf"

    cat > "$ROOTFS/settings/about" <<EOF
ID=$OS_ID
NAME="$OS_NAME"
VERSION="$OS_VERSION"
PRETTY_NAME="$OS_NAME $OS_VERSION"
EOF
    echo "$OS_ID" > "$ROOTFS/settings/hostname"

    for p in $PARTS; do install_part "$p"; done
}

# Build the initramfs with the kernel's own gen_init_cpio, so device nodes and
# ownership are correct without needing root on the build machine.
make_image() {
    local gen="$BUILDS/linux/usr/gen_init_cpio" list="$WORK/initramfs.list"
    [ -x "$gen" ] || die "gen_init_cpio not found; build linux first"
    log "create initramfs"
    {
        echo "nod /dev/console 0600 0 0 c 5 1"
        echo "nod /dev/null 0666 0 0 c 1 3"
        (cd "$ROOTFS" && find . -mindepth 1 | LC_ALL=C sort) | while read -r p; do
            local rel="${p#./}" full="$ROOTFS/${p#./}" mode
            [ "$rel" = "dev/console" ] || [ "$rel" = "dev/null" ] && continue
            mode="$(stat -c '%a' "$full")"
            if [ -L "$full" ]; then
                echo "slink /$rel $(readlink "$full") 0777 0 0"
            elif [ -d "$full" ]; then
                echo "dir /$rel $mode 0 0"
            else
                echo "file /$rel $full $mode 0 0"
            fi
        done
    } > "$list"
    mkdir -p "$OUT"
    "$gen" "$list" | gzip -9 > "$OUT/rootfs.cpio.gz"
    log "out/kernel ($(du -h "$OUT/kernel" | cut -f1)), out/rootfs.cpio.gz ($(du -h "$OUT/rootfs.cpio.gz" | cut -f1))"
}

# --- QEMU -------------------------------------------------------------------

qemu_cmd() {
    local accel="tcg"
    [ -w /dev/kvm ] && accel="kvm"
    echo qemu-system-x86_64 -accel "$accel" -m 1024 -smp 2 -nographic -no-reboot \
        -kernel "$OUT/kernel" -initrd "$OUT/rootfs.cpio.gz" \
        -netdev user,id=n0 -device virtio-net-pci,netdev=n0
}

cmd_run() {
    log "booting in QEMU — Ctrl-A then X to quit"
    # shellcheck disable=SC2046
    exec $(qemu_cmd) -append "console=ttyS0 rdinit=/core/cmd/keeper"
}

# Fetch the newest kernel + root filesystem that GitHub built and tested, so
# you can try the OS without building anything (e.g. in a Codespace).
cmd_try() {
    command -v gh >/dev/null 2>&1 || die "needs the GitHub CLI (gh): https://cli.github.com"
    command -v qemu-system-x86_64 >/dev/null 2>&1 || die "needs QEMU (qemu-system-x86)"
    local repo run
    repo="${GITHUB_REPOSITORY:-$(git -C "$ROOT" remote get-url origin | sed -E 's#.*github.com[:/]##; s#\.git$##')}"
    run="$(gh run list -R "$repo" --workflow build --branch main --status success --limit 1 \
           --json databaseId -q '.[0].databaseId')"
    [ -n "$run" ] || die "no successful GitHub build found yet"
    log "downloading GitHub build $run"
    rm -rf "$OUT.download"
    gh run download "$run" -R "$repo" -D "$OUT.download" || die "download failed (your previous build in out/ is untouched)"
    rm -rf "$OUT"
    mkdir -p "$OUT"
    find "$OUT.download" -type f -exec mv {} "$OUT/" \;
    rm -rf "$OUT.download"
    [ -f "$OUT/kernel" ] && [ -f "$OUT/rootfs.cpio.gz" ] || die "that build has no kernel or root filesystem"
    cmd_run
}

cmd_test() {
    local log_file="$OUT/boot-test.log"
    log "boot test (log: $log_file)"
    # shellcheck disable=SC2046
    timeout 600 $(qemu_cmd) -append "console=ttyS0 rdinit=/core/cmd/keeper mtp.test=1 panic=-1" \
        < /dev/null > "$log_file" 2>&1 || true
    if grep -q "CHECKUP PASS" "$log_file" && grep -q "reboot: Power down" "$log_file"; then
        grep -E "CHECKUP|^  (ok|FAIL)" "$log_file" || true
        log "boot test passed"
    else
        tail -n 60 "$log_file"
        die "boot test failed"
    fi
}

# --- main -------------------------------------------------------------------

main() {
    local cmd="${1:-all}"
    case "$cmd" in
        all)
            need_tools
            for p in $PARTS; do build_part "$p"; done
            assemble_rootfs
            make_image
            ;;
        image)     need_tools; assemble_rootfs; make_image ;;
        test)      cmd_test ;;
        run)       cmd_run ;;
        try)       cmd_try ;;
        clean)     rm -rf "$BUILDS" "$ROOTFS" "$SYSROOT" "$OUT" "$WORK/initramfs.list" ;;
        distclean) rm -rf "$WORK" "$OUT" ;;
        *)
            [ -f "$(part_file "$cmd")" ] || die "unknown command or part: $cmd"
            need_tools
            FORCE=1 build_part "$cmd"
            ;;
    esac
}

main "$@"
